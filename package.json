{
  "name": "ikun-vscode-theme",
  "displayName": "IKUN Club · 背带裤与篮球",
  "description": "中分小鸡、背带裤口袋、语言球衣和篮球终端。原创图标系统与三套离线配色。",
  "version": "0.3.0",
  "publisher": "qianxunslimg",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "ikun",
    "蔡徐坤",
    "篮球",
    "theme",
    "dark",
    "light"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#141416",
    "theme": "dark"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "IKUN · 背带裤黑",
        "uiTheme": "vs-dark",
        "path": "./themes/suspenders-color-theme.json"
      },
      {
        "label": "IKUN · 球场白",
        "uiTheme": "vs",
        "path": "./themes/court-color-theme.json"
      },
      {
        "label": "IKUN · 舞台夜",
        "uiTheme": "vs-dark",
        "path": "./themes/stage-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ikun-file-icons",
        "label": "IKUN · 球场文件图标",
        "path": "./icons/ikun-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "ikun-product-icons",
        "label": "IKUN · 唱跳 RAP 篮球",
        "path": "./icons/ikun-product-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "ikun.openClub",
        "title": "IKUN: 打开主题衣柜"
      },
      {
        "command": "ikun.applyDaily",
        "title": "IKUN: 启用日常套装"
      },
      {
        "command": "ikun.applyStage",
        "title": "IKUN: 启用整活套装"
      },
      {
        "command": "ikun.restore",
        "title": "IKUN: 恢复之前的外观"
      },
      {
        "command": "ikun.applyIcons",
        "title": "IKUN: 启用 IKUN 图标"
      },
      {
        "command": "ikun.restoreIcons",
        "title": "IKUN: 仅恢复之前的图标"
      },
      {
        "command": "ikun.restoreFileIcons",
        "title": "IKUN: 只恢复文件图标"
      },
      {
        "command": "ikun.restoreProductIcons",
        "title": "IKUN: 只恢复活动栏图标"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ikun",
          "title": "IKUN Club",
          "icon": "media/basketball.svg"
        }
      ]
    },
    "views": {
      "ikun": [
        {
          "type": "webview",
          "id": "ikun.practice",
          "name": "主题衣柜"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/extension.js && node --check src/colors.js && node --check media/club.js && node scripts/validate.mjs",
    "test": "node --test test/*.test.cjs",
    "package": "npm run check && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build",
    "test:icons": "node scripts/icons-test.mjs",
    "test:visual": "node scripts/icons-test.mjs && node scripts/preview-test.mjs && node scripts/icon-atlas.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@vscode/vsce": "^3.6.0",
    "playwright": "^1.56.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qianxunslimg/ikun-vscode-theme"
  }
}
