  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A79BB8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#B5DBB1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D9B1F2"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F4AF75"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A7CFF4"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E9D49A"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EFE7F4"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A7CFF4"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F4AF75"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A79BB8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EFE7F4"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F4AF75",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EFE7F4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EFE7F4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#A7CFF4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#B5DBB1"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F797B2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F797B2"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A7CFF4",
    "type": "#A7CFF4",
    "class": "#A7CFF4",
    "enum": "#A7CFF4",
    "interface": "#A7CFF4",
    "typeParameter": "#A7CFF4",
    "function": "#F4AF75",
    "method": "#F4AF75",
    "macro": "#F4AF75",
    "keyword": "#D9B1F2",
    "parameter": "#EFE7F4",
    "variable": "#EFE7F4",
    "property": "#A7CFF4",
    "enumMember": "#E9D49A",
    "variable.readonly": "#E9D49A",
    "property.readonly": "#E9D49A",
    "string": "#B5DBB1",
    "number": "#E9D49A",
    "comment": {
      "foreground": "#A79BB8",
      "italic": true
    },
    "decorator": "#D9B1F2"
  }
}
